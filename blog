#!/usr/bin/env bash
# Atajos para escribir, revisar y publicar el blog.
# Uso: ./blog <comando> [opciones]   (./blog ayuda para ver la lista)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

HUGO_VERSION_PINNED="$(tr -d '[:space:]' < .hugo-version)"
WORKFLOW="deploy.yml"
SITE_URL="https://nsstudent.dev"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '\033[36m▸\033[0m %s\n' "$*"; }
warn() { printf '\033[33m⚠\033[0m %s\n' "$*"; }
fail() { printf '\033[31m✖\033[0m %s\n' "$*" >&2; exit 1; }

require() { command -v "$1" >/dev/null 2>&1 || fail "Falta '$1'. $2"; }

check_hugo() {
  require hugo "Instálalo con: brew install hugo"
  local local_version
  local_version="$(hugo version | sed -E 's/^hugo v([0-9.]+).*/\1/')"
  if [ "$local_version" != "$HUGO_VERSION_PINNED" ]; then
    warn "Tienes Hugo $local_version y la web se publica con $HUGO_VERSION_PINNED (.hugo-version)."
    warn "Si algo se ve distinto en producción, empieza por aquí."
  fi
}

ensure_theme() {
  if [ ! -f themes/blowfish/theme.toml ]; then
    info "Descargando el tema (submódulo)…"
    git submodule update --init themes/blowfish
  fi
}

slugify() {
  perl -CSA -MUnicode::Normalize -e '
    $_ = NFD(shift); s/\pM//g; $_ = lc;
    s/[^a-z0-9]+/-/g; s/^-+|-+$//g; print' "$1"
}

list_drafts() {
  hugo list drafts 2>/dev/null | tail -n +2 | cut -d, -f1
}

cmd_ayuda() {
  cat <<EOF
$(bold "Uso: ./blog <comando>")

  nuevo "Título" [--en]   Crea un post (borrador) en español; --en añade también la versión en inglés
  ver                     Servidor local con borradores en http://localhost:1313 (se recarga solo)
  comprobar               Compila como en producción y avisa de errores, avisos y borradores
  publicar ["mensaje"]    Comprueba, hace commit de todo, sube a GitHub y sigue el despliegue
  estado                  Últimos despliegues en GitHub Actions
  borradores              Lista los posts que siguen en draft: true
  actualizar-tema         Actualiza Blowfish a la última versión y comprueba que compila

Flujo normal:  ./blog nuevo "Mi post"  →  ./blog ver  →  quita draft: true  →  ./blog publicar
EOF
}

cmd_nuevo() {
  local title="" en=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --en) en=true ;;
      *) title="${title:+$title }$1" ;;
    esac
    shift
  done
  [ -n "$title" ] || fail 'Indica un título: ./blog nuevo "Mi nuevo post" [--en]'
  check_hugo
  ensure_theme

  local slug stamp dir
  slug="$(slugify "$title")"
  stamp="$(perl -MTime::HiRes=time -e 'printf "%d", time * 1000')"
  dir="posts/${stamp}-${slug}"

  HUGO_TITLE="$title" hugo new content "$dir/index.es.md" >/dev/null
  info "Creado content/$dir/index.es.md"
  if $en; then
    HUGO_TITLE="$title" hugo new content "$dir/index.en.md" >/dev/null
    info "Creado content/$dir/index.en.md"
  fi

  if command -v code >/dev/null 2>&1; then
    code "content/$dir/index.es.md"
  fi
  echo
  echo "Siguiente paso: ./blog ver   (los borradores se ven en local, no se publican)"
}

cmd_ver() {
  check_hugo
  ensure_theme
  info "Abriendo http://localhost:1313 (Ctrl+C para parar)"
  exec hugo server --buildDrafts --buildFuture --renderToMemory --navigateToChanged --openBrowser
}

cmd_comprobar() {
  check_hugo
  ensure_theme
  local out log
  out="$(mktemp -d)"
  log="$out.log"
  info "Compilando como en producción…"
  if ! hugo build --gc --minify --environment production --destination "$out" --logLevel warn >"$log" 2>&1; then
    cat "$log"
    rm -rf "$out" "$log"
    fail "La compilación ha fallado. Arregla los errores de arriba antes de publicar."
  fi
  if grep -qE '^(WARN|ERROR)' "$log"; then
    grep -E '^(WARN|ERROR)' "$log"
    warn "Compila, pero con avisos."
  else
    info "Compila sin errores ni avisos."
  fi
  rm -rf "$out" "$log"

  local drafts
  drafts="$(list_drafts)"
  if [ -n "$drafts" ]; then
    warn "Estos posts siguen en borrador y NO se publicarán:"
    printf '    %s\n' $drafts
  fi
}

cmd_publicar() {
  local message="${1:-}"
  require gh "Instálalo con: brew install gh"
  cmd_comprobar
  echo

  if [ -z "$(git status --porcelain)" ]; then
    if [ -z "$(git log '@{u}..' --oneline 2>/dev/null)" ]; then
      info "No hay cambios que publicar."
      return 0
    fi
  else
    git add -A
    bold "Se va a publicar:"
    git status --short
    if [ -z "$message" ]; then
      local titles="" file title
      while IFS= read -r file; do
        title="$(sed -n 's/^title: *"\{0,1\}\([^"]*\)"\{0,1\} *$/\1/p' "$file" | head -1)"
        [ -n "$title" ] && titles="${titles:+$titles, }$title"
      done < <(git diff --cached --name-only --diff-filter=AM -- 'content/*.md')
      message="${titles:+publica: $titles}"
      message="${message:-actualiza el blog}"
    fi
    git commit -q -s -m "$message"
    info "Commit: $message"
  fi

  info "Subiendo a GitHub…"
  git push -q
  sleep 5
  local run_id
  run_id="$(gh run list --workflow "$WORKFLOW" --branch main --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null || true)"
  if [ -n "$run_id" ]; then
    info "Desplegando (puedes cerrar esto, sigue en GitHub)…"
    if gh run watch "$run_id" --exit-status >/dev/null; then
      info "Publicado en $SITE_URL"
    else
      fail "El despliegue ha fallado: gh run view $run_id --log-failed"
    fi
  else
    warn "No encuentro el despliegue; míralo con ./blog estado"
  fi
}

cmd_estado() {
  require gh "Instálalo con: brew install gh"
  gh run list --workflow "$WORKFLOW" --limit 5
}

cmd_borradores() {
  check_hugo
  local drafts
  drafts="$(list_drafts)"
  if [ -n "$drafts" ]; then printf '%s\n' $drafts; else info "No hay borradores."; fi
}

cmd_actualizar_tema() {
  local before after
  before="$(git -C themes/blowfish describe --tags 2>/dev/null || echo '?')"
  git submodule update --init --remote themes/blowfish
  after="$(git -C themes/blowfish describe --tags 2>/dev/null || echo '?')"
  info "Blowfish: $before → $after"
  cmd_comprobar
  echo "Revísalo con ./blog ver y, si todo está bien, ./blog publicar \"actualiza blowfish a $after\""
}

command="${1:-ayuda}"
[ $# -gt 0 ] && shift
case "$command" in
  nuevo|new)                cmd_nuevo "$@" ;;
  ver|serve)                cmd_ver ;;
  comprobar|check)          cmd_comprobar ;;
  publicar|publish)         cmd_publicar "$@" ;;
  estado|status)            cmd_estado ;;
  borradores|drafts)        cmd_borradores ;;
  actualizar-tema|update)   cmd_actualizar_tema ;;
  ayuda|help|-h|--help)     cmd_ayuda ;;
  *) cmd_ayuda; exit 1 ;;
esac
